# CASELINK Backend Configuration
PROJECT_NAME="CASELINK Investigation Intelligence Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="temporary-insecure-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL="postgresql://caselink_user:caselink_password@localhost:5432/caselink_db"

# Graph Database (Optional: Neo4j / NetworkX fallback)
USE_NEO4J=false
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
